AI_BRIDGE_HOST=127.0.0.1
AI_BRIDGE_PORT=8787
AI_BRIDGE_DB=./data/ai-bridge.db
# Required when AI_BRIDGE_HOST is not loopback. Use a long random value.
AI_BRIDGE_REGISTRATION_TOKEN=replace-with-a-long-random-token
AI_BRIDGE_MAX_REPLY_DEPTH=16
AI_BRIDGE_RATE_LIMIT_PER_MINUTE=120
AI_BRIDGE_LONG_POLL_MAX_SECONDS=30
