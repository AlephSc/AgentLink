# Salin ke /etc/agentlink.env, lalu: chown root:root /etc/agentlink.env && chmod 600 /etc/agentlink.env
# Buat token registrasi dengan: openssl rand -hex 32
AI_BRIDGE_HOST=0.0.0.0
AI_BRIDGE_PORT=8787
AI_BRIDGE_DB=/var/lib/agentlink/agentlink.db
AI_BRIDGE_REGISTRATION_TOKEN=ganti-dengan-token-acak-panjang
AI_BRIDGE_MAX_REPLY_DEPTH=8
AI_BRIDGE_RATE_LIMIT_PER_MINUTE=120
AI_BRIDGE_LONG_POLL_MAX_SECONDS=30
