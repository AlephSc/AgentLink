{
  "name": "universal-ai-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Universal MCP broker for messages, shared data, and update notifications between AI agents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
